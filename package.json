{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@babel/core": "^7.22.5",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.22.5",
    "@babel/preset-react": "^7.22.5",
    "@hello-pangea/dnd": "^16.6.0",
    "@nivo/core": "^0.88.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.21.1",
    "chart.js": "^4.4.4",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.0.1",
    "chartjs-plugin-crosshair": "^2.0.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "customize-cra": "^1.0.0",
    "date-fns": "^4.1.0",
    "i18next": "^26.7.2",
    "rc-slider": "^11.1.8",
    "react": "^18.3.1",
    "react-app-rewired": "^2.2.1",
    "react-chartjs-2": "^5.2.0",
    "react-datepicker": "^7.5.0",
    "react-dom": "^18.3.1",
    "react-gauge-chart": "^0.5.1",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^15.5.1",
    "react-icons": "^4.0.0",
    "react-markdown": "^9.0.3",
    "react-modal": "^3.16.3",
    "react-responsive": "^9.0.0",
    "react-router-dom": "^7.18.7",
    "react-scripts": "^5.0.1",
    "recharts": "^2.13.3",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.1.13",
    "use-debounce": "^10.0.4",
    "web-vitals": "^2.1.4"
  },
  "overrides": {
    "react-scripts": {
      "bfj": "^9.1.5"
    }
  },
  "scripts": {
    "build": "node scripts/generate-locale-resources.js && SKIP_PREFLIGHT_CHECK=true GENERATE_SOURCEMAP=false ESLINT_NO_DEV_ERRORS=true react-app-rewired build",
    "postbuild": "node scripts/verify-article-locales.js && node scripts/add-ko-sitemap-locale.js && node scripts/generate-seo-shells.js",
    "build:staging": "node scripts/generate-locale-resources.js && REACT_APP_ENVIRONMENT=staging SKIP_PREFLIGHT_CHECK=true GENERATE_SOURCEMAP=false ESLINT_NO_DEV_ERRORS=true react-app-rewired build",
    "build:original": "node scripts/generate-locale-resources.js && SKIP_PREFLIGHT_CHECK=true GENERATE_SOURCEMAP=false react-scripts build",
    "perf:budget": "node ./scripts/check-performance-budget.js",
    "start": "node scripts/generate-locale-resources.js && react-app-rewired start",
    "start:staging": "node scripts/generate-locale-resources.js && REACT_APP_ENVIRONMENT=staging react-app-rewired start",
    "test": "react-app-rewired test",
    "test:ci": "node ./scripts/run-ci-tests.js",
    "test:regression": "node ./scripts/run-ci-tests.js --regression",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "eject": "react-scripts eject",
    "locales:check": "node scripts/generate-locale-resources.js --check",
    "articles:check": "node scripts/verify-article-locales.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}",
      "!src/**/*.spec.{js,jsx}",
      "!src/**/__tests__/**",
      "!src/**/setupTests.js"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov",
      "json"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 40,
        "branches": 38,
        "functions": 40,
        "lines": 40
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "ajv": "^8.12.0",
    "ajv-keywords": "^5.1.0",
    "clean-css-loader": "^4.2.1",
    "schema-utils": "^4.2.0"
  }
}
